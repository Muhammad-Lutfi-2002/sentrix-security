# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- Supabase (SENTRIX V2) ---
# Dashboard > Project Settings > API Keys. Never commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed by the scanner worker / trusted server tasks. NEVER ship to the browser.
SUPABASE_SECRET_KEY=

# Allow self-service sign-up (default: disabled). Enable only for the first owner or demos.
SIGNUP_ENABLED=false

# Secret used to derive target-ownership challenge tokens (defaults to SUPABASE_SECRET_KEY if unset).
VERIFICATION_SECRET=

# Scanner worker parallelism (1-4).
WORKER_CONCURRENCY=1
